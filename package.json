{
  "name": "trao-ai-interview-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns a job description and a company site into a personalised interview preparation kit.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trao/api --filter @trao/web dev",
    "build": "pnpm -r build",
    "build:production": "pnpm --filter @trao/web build:production && pnpm --filter @trao/api build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "echo \"No browser/E2E tests exist yet; see docs/verification.md\" && exit 1",
    "evaluate": "tsx scripts/evaluate.ts",
    "llm:smoke": "tsx --env-file=.env scripts/llm-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@trao/pipeline": "workspace:*"
  }
}
