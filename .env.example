# Copy to .env and fill in. Never commit .env. Values below are placeholders.
# `pnpm dev` loads ../../.env for the API; in production set these in the host's secret store.

# --- Runtime ---
NODE_ENV=development
# Express API port
PORT=4000
# The single browser origin allowed by CORS and by the CSRF Origin check (scheme + host + port)
WEB_ORIGIN=http://localhost:3000
# Base URL of the API as seen by the browser (exposed to the client bundle — never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (0 = none). Needed behind Render/Fly/etc. so
# rate limiting counts the client IP. Setting this wrongly lets clients spoof their IP.
TRUST_PROXY=0

# --- Database (MongoDB) ---
# Local Docker: matches compose.yaml. Atlas: use the mongodb+srv connection string.
# NOTE: the port is MONGO_PORT below. Use 27018 if something else already owns 27017.
MONGODB_URI=mongodb://trao:change-me-local-only@localhost:27017/trao?authSource=admin
MONGO_ROOT_USER=trao
MONGO_ROOT_PASSWORD=change-me-local-only
# Host port that compose.yaml publishes MongoDB on (loopback only)
MONGO_PORT=27017
# Used only by `pnpm test:integration`. Each test file creates and drops its own throwaway
# database on this server. Defaults to the compose service above on port 27018.
TEST_MONGODB_URI=mongodb://trao:change-me-local-only@localhost:27017/?authSource=admin

# --- Sessions ---
# Keyed-hash secret for session ids: the database stores HMAC(secret, token), never the token.
# Production requires >= 32 random characters; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Absolute session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168
# lax (default) | strict | none. `none` is for a frontend and API on different sites; it needs
# production mode (Secure cookies) and relies on the Origin check for CSRF protection.
COOKIE_SAMESITE=lax

# --- Rate limiting (in-memory, per process) ---
# Register + login attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10
# All other API requests per IP per minute
API_RATE_LIMIT_MAX=300

# --- LLM provider ---
# Only "gemini" is implemented; the code is provider-neutral so another can be added.
LLM_PROVIDER=gemini
# Model id. Never substituted automatically: if it is unavailable, calls fail with MODEL_NOT_FOUND.
# gemini-3.8-flash is listed as Stable with a free tier in Google's docs (checked 2026-10-19).
LLM_MODEL=gemini-3.8-flash
# SERVER-SIDE ONLY. Create a key at https://aistudio.google.com/apikey and keep it in .env (git-ignored).
# Never put it in NEXT_PUBLIC_* variables, source code, logs or screenshots. Missing key = clear
# configuration error and no request is made.
# PRIVACY: on Google's free tier, prompts and responses may be used to improve Google's products and
# may be read by human reviewers. Do not paste confidential or personal information into job descriptions.
LLM_API_KEY=
# low | medium | high. "minimal" is rejected by gemini-3.8-flash. Thinking tokens add latency and count as output.
LLM_THINKING_LEVEL=low
# Time allowed for ONE attempt (ms). Free-tier latency has long tails, so this is deliberately short and a retry follows.
LLM_REQUEST_TIMEOUT_MS=60000
# Retries after the first attempt, for rate limits, timeouts and 5xx only (exponential backoff + jitter, honours Retry-After)
LLM_MAX_RETRIES=3
# Simultaneous model requests. Higher is faster but burns per-minute quota sooner.
LLM_MAX_CONCURRENCY=2
# Minimum gap between the starts of two model requests (ms). 0 = no pacing. Raise it if you hit 429s.
LLM_MIN_INTERVAL_MS=0

# --- Batch command (npm run evaluate) ---
# `npm run evaluate` loads this .env file if it exists; otherwise it reads the process environment.
# Everything for ONE case (research plus generation) must finish within this long. Default 90000 (90 s).
# A case that runs out of time is recorded as failed (DEADLINE_EXCEEDED) or, if a kit exists, as an incomplete kit.
EVALUATE_CASE_DEADLINE_MS=90000
# Everything for the WHOLE batch. Default 840000 (14 min), so five cases of 90 s each fit with room to spare
# inside the 15-minute target. Cases that no longer fit are recorded as failed (BATCH_DEADLINE_EXCEEDED).
EVALUATE_BATCH_DEADLINE_MS=840000

# --- Research safety ---
# Allow the API to research a company site on loopback (local development and the batch fixtures): only the
# company URL's own host and port is allowed, never private ranges or other ports.
# The batch command allows the same for its cases unless NODE_ENV=production.
# Must be false in production; the production server refuses to start with this enabled.
ALLOW_PRIVATE_HOSTS=false
