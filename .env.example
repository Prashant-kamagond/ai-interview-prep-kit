# Copy to .env and fill in. Never commit .env. Values below are placeholders.

# --- Runtime ---
NODE_ENV=development
# Express API port
PORT=4000
# Public origin of the web app, used for the CORS allow-list (no trailing slash)
WEB_ORIGIN=http://localhost:3000
# Base URL of the API as seen by the browser (exposed to the client bundle — never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database (MongoDB) ---
# Local Docker: matches compose.yaml. Atlas: use the mongodb+srv connection string.
MONGODB_URI=mongodb://trao:change-me-local-only@localhost:27017/trao?authSource=admin
MONGO_ROOT_USER=trao
MONGO_ROOT_PASSWORD=change-me-local-only

# --- Sessions ---
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=replace-with-a-long-random-string

# --- LLM provider (adapter-based; provider chosen and documented in Phase 5) ---
LLM_PROVIDER=gemini
LLM_MODEL=
# Server-side only. Create a key in Google AI Studio; see README "LLM provider".
LLM_API_KEY=

# --- Research safety ---
# Allow fetching loopback/private hosts. ONLY for local development and the batch CLI fixtures.
# Must be false in production; the production server refuses to start with this enabled.
ALLOW_PRIVATE_HOSTS=false
